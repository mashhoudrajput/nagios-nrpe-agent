# Sample Host Configuration
# This is an example - hosts will be dynamically added via the GUI

# Localhost definition (optional)
define host {
    use                     linux-server
    host_name               localhost
    alias                   Local Host
    address                 127.0.0.1
    max_check_attempts      5
    check_period            24x7
    notification_interval   30
    notification_period     24x7
}
